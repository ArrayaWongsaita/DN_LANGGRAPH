# ไฟล์ตัวอย่าง: คัดลอกเป็น .env แล้วแก้ค่า (ห้าม commit ไฟล์ .env)

# บท 028: เลือก provider หลักของ LLM (ollama หรือ google)
LLM_PROVIDER=google

# บท 003: ที่อยู่ Ollama (เครื่องตัวเองใช้ http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
# Ollama Cloud แบบยิงตรง (ไม่ผ่านเครื่องตัวเอง): เปลี่ยนค่า OLLAMA_BASE_URL ข้างบนเป็น https://ollama.com
# แล้วใส่ key ที่บรรทัด OLLAMA_API_KEY ด้านล่าง (มีบรรทัดเดียว ห้ามเพิ่มบรรทัดซ้ำ)

# บท 003: ชื่อโมเดล Ollama (Task 6 จะกำหนดค่าจริง)
OLLAMA_MODEL=CHANGE_ME

# บท 003: ขนาด context window ของ Ollama (Task 6 จะกำหนดค่าจริง)
OLLAMA_NUM_CTX=CHANGE_ME

# บท 004: API key ของ Ollama (ใช้เมื่อยิง Ollama Cloud ตรงเท่านั้น)
OLLAMA_API_KEY=

# บท 005: API key ของ Google AI Studio
GOOGLE_API_KEY=

# บท 005: ชื่อโมเดล Google (Task 6 จะกำหนดค่าจริง)
GOOGLE_MODEL=CHANGE_ME

# บท 045: เปิด/ปิด LangSmith tracing (true หรือ false)
LANGSMITH_TRACING=false

# บท 046: API key ของ LangSmith
LANGSMITH_API_KEY=

# บท 091: provider ของ embeddings (ollama หรือ google)
EMBEDDINGS_PROVIDER=google

# บท 091: โมเดล embeddings ของ Ollama
OLLAMA_EMBED_MODEL=embeddinggemma

# บท 115: ลำดับ provider สำรองเมื่อตัวหลักล้มเหลว
FALLBACK_PROVIDERS=google,ollama

# บท 146: connection string ของฐานข้อมูล Postgres
DATABASE_URL=

# บท 147: รหัสผ่านหน้าเว็บ
WEB_PASSWORD=

# บท 147: จำนวนข้อความสูงสุดต่อหนึ่งการสนทนาบนเว็บ
WEB_MESSAGE_LIMIT=

# บท 147: เลขบทที่ใช้ deploy
DEPLOY_LESSON=

# เฉพาะผู้สอน: API key ของ opencode (ใช้กับ pnpm verify --provider opencode-dev) ห้ามใส่ค่าในไฟล์นี้
# OPENCODE_API_KEY=
# เฉพาะผู้สอน: ชื่อโมเดลที่ใช้ทดสอบผ่าน opencode
# OPENCODE_DEV_MODEL=
